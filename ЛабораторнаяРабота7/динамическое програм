n = int(input())
costs = []
for i in range(n):
    costs.append(int(input()))
dp = [[float('inf')] * (n + 2) for _ in range(n + 1)]
dp[0][0] = 0
for i in range(1, n + 1):
    cost = costs[i - 1]
    for j in range(n + 1):
        if cost > 500:
            if j > 0:
                dp[i][j] = min(dp[i][j], dp[i - 1][j - 1] + cost)
        else:
            dp[i][j] = min(dp[i][j], dp[i - 1][j] + cost)
            
        dp[i][j] = min(dp[i][j], dp[i - 1][j + 1])
min_cost = float('inf')
best_j = 0
for j in range(n + 1):
    if dp[n][j] <= min_cost:
        min_cost = dp[n][j]
        best_j = j
used_coupons_days = []
curr_j = best_j
total_coupons_spent = 0
for i in range(n, 0, -1):
    cost = costs[i - 1]
    if dp[i][curr_j] == dp[i - 1][curr_j + 1]:
        used_coupons_days.append(i)
        total_coupons_spent += 1
        curr_j += 1
    else:
        if cost > 500:
            curr_j -= 1
used_coupons_days.reverse()
print(f"{min_cost} {total_coupons_spent}")
if used_coupons_days:
    print(*(used_coupons_days))
