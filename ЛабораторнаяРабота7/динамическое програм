from functools import lru_cache
import sys
sys.setrecursionlimit(200000)
def main():
    n = int(input())
    costs = []
    for i in range(n):
        costs.append(int(input()))
    @lru_cache(None)
    def solve(day, coupons):
        if day == n:
            return 0
        cost = costs[day]
        res = float('inf')
        if coupons > 0:
            res = min(res, solve(day + 1, coupons - 1))
        if cost > 500:
            res = min(res, cost + solve(day + 1, coupons + 1))
        else:
            res = min(res, cost + solve(day + 1, coupons))
        return res
    min_cost = solve(0, 0)
    used_coupons_days = []
    curr_coupons = 0
    for day in range(n):
        cost = costs[day]
        if curr_coupons > 0 and solve(day, curr_coupons) == solve(day + 1, curr_coupons - 1):
            used_coupons_days.append(day + 1)
            curr_coupons -= 1
        else:
            if cost > 500:
                curr_coupons += 1

    print(f"{min_cost} {len(used_coupons_days)}")
    if used_coupons_days:
        print(*(used_coupons_days))

main()

